# ── Question Bank — environment variables ─────────────────────────
# Copy this file to .env and fill in the values before starting.
# The Makefile `make setup` does this automatically.

# Generate a fresh key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=replace-with-a-random-64-char-hex-string

# Optional: override the default SQLite database path.
# Leave blank to use ./question_bank.db in the project root.
# DATABASE_URL=sqlite:///./question_bank.db

# Optional: bind address and port (defaults: 127.0.0.1 / 8000)
# HOST=127.0.0.1
# PORT=8000
